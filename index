// ── CSV ──
function parseCSVLine(line){const r=[];let c='',q=false;for(let i=0;i<line.length;i++){const ch=line[i];if(ch==='"'){q=!q}else if(ch===','&&!q){r.push(c);c=''}else c+=ch}r.push(c);return r}
function parseCSV(text){const lines=text.trim().split('\n');const headers=parseCSVLine(lines[0]);return lines.slice(1).map(l=>{const v=parseCSVLine(l),o={};headers.forEach((h,i)=>o[h.trim()]=(v[i]||'').trim());return o})}
function num(r,col){return parseFloat((r[col]||'0').replace(/,/g,''))||0}

// ── Formatters ──
function fmt(n){if(n>=1e9)return(n/1e9).toFixed(1)+'B';if(n>=1e6)return(n/1e6).toFixed(1)+'M';if(n>=1e3)return Math.round(n/1e3)+'K';return Math.round(n).toLocaleString()}
function fmtVND(n){if(n>=1e9)return(n/1e9).toFixed(2)+'B ₫';if(n>=1e6)return(n/1e6).toFixed(1)+'M ₫';if(n>=1e3)return Math.round(n/1e3)+'K ₫';return Math.round(n).toLocaleString()+'₫'}
function fmtPct(n){if(n===null||isNaN(n)||!isFinite(n))return'—';return n.toFixed(1)+'%'}
function delta(curr,prev,lowerBetter=false){
  if(!prev||prev===0)return`<span class="delta flat">—</span>`;
  const p=((curr-prev)/prev)*100;
  const good=lowerBetter?p<=0:p>=0;
  const cls=Math.abs(p)<0.5?'flat':good?'up':'down';
  const arrow=p>=0?'↑':'↓';
  return`<span class="delta ${cls}">${arrow}${Math.abs(p).toFixed(1)}%</span>`;
}

// ── Aggregate ──
function agg(rows){
  const imp=rows.reduce((s,r)=>s+num(r,'Impressions'),0);
