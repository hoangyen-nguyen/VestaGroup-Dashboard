  if(!p&&p!==0)return'—';
  const cls=p>=25?'hook-good':p>=10?'hook-mid':'hook-low';
  return`<span class="hook-badge ${cls}">${p.toFixed(1)}%</span>`;
}
function badgeClass(obj){if(!obj)return'badge-other';const o=obj.toLowerCase();if(o.includes('traffic'))return'badge-traffic';if(o.includes('ctm')||o.includes('message'))return'badge-ctm';if(o.includes('aware'))return'badge-awareness';return'badge-other'}
function thCls(col){return col===sortCol?(sortDir===-1?'sort-desc':'sort-asc'):''}

// ── Deep dive helper ──
function deepDiveRows(data,metric,groupCol){
  const map={};
  data.forEach(r=>{
    const k=r[groupCol]||'Unknown';
    if(!map[k])map[k]={spend:0,imp:0,clicks:0,results:0,convs:0,igVisit:0,vid3s:0};
    map[k].spend+=num(r,'Amount spent (VND)');
    map[k].imp+=num(r,'Impressions');
    map[k].clicks+=num(r,'Link clicks');
    map[k].results+=num(r,'Results');
    map[k].convs+=num(r,'Messaging conversations started');
    map[k].igVisit+=num(r,'Instagram profile visits');
    map[k].vid3s+=num(r,'3-second video plays');
  });
  const getVal=v=>{switch(metric){
    case'igVisit':return v.igVisit;case'conv':return v.convs;
    case'cpi':return v.igVisit>0?v.spend/v.igVisit:Infinity;
    case'cpconv':return v.convs>0?v.spend/v.convs:Infinity;
    case'ctr':return v.imp>0?v.clicks/v.imp*100:0;
    case'hook':return v.imp>0?v.vid3s/v.imp*100:0;
    default:return v.spend;
  }};
  const lower=['cpi','cpconv'].includes(metric);
  const sorted=Object.entries(map).filter(([,v])=>v.spend>0)
    .sort((a,b)=>lower?getVal(a[1])-getVal(b[1]):getVal(b[1])-getVal(a[1])).slice(0,6);
  const maxVal=sorted[0]?getVal(sorted[0][1]):1;
  const minVal=sorted[sorted.length-1]?getVal(sorted[sorted.length-1][1]):0;
  return sorted.map(([name,v],i)=>{
    const val=getVal(v);
    const bw=lower?(maxVal===minVal?100:Math.max(8,Math.round((1-(val-minVal)/(maxVal-minVal+1))*100))):maxVal>0?Math.round(val/maxVal*100):0;
    let display;
    if(['cpi','cpconv','spend'].includes(metric))display=fmtVND(Math.round(val==='Infinity'?0:val));
    else if(['ctr','hook'].includes(metric))display=fmtPct(val);
    else display=fmt(val);
    return{rank:i+1,name,bw,display};
  });
