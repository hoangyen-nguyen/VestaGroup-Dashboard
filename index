// ── Load data ──
async function loadData(){
  try{
    let text;
    try{
      const r1=await fetch(CSV_PRIMARY+'&_='+Date.now());
      if(!r1.ok)throw new Error('primary 404');
      text=await r1.text();
      if(!text.includes(','))throw new Error('bad response');
    }catch(_){
      const r2=await fetch(CSV_FALLBACK+'&_='+Date.now());
      if(!r2.ok)throw new Error('Could not load sheet — check sharing settings (Anyone with link)');
      text=await r2.text();
    }
    allData=parseCSV(text).filter(r=>r['Brand']&&r['Date']);
    document.getElementById('update-time').textContent='Updated '+new Date().toLocaleTimeString('vi-VN');
    render();
  }catch(e){
    document.getElementById('main-content').innerHTML=`<div class="error-state"><strong>Could not load data</strong><p>${e.message}</p></div>`;
  }
}

function switchBrand(brand,btn){
  currentBrand=brand;
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  render();
}
function getFilters(){return{month:document.getElementById('filter-month')?.value||'all',activity:document.getElementById('filter-activity')?.value||'all',objective:document.getElementById('filter-objective')?.value||'all',dateFrom:document.getElementById('filter-date-from')?.value||'',dateTo:document.getElementById('filter-date-to')?.value||''}}
function applyFilters(data){
  const f=getFilters();
  return data.filter(r=>{
    if(f.month!=='all'&&r['Month']!==f.month)return false;
    if(f.activity!=='all'&&r['Activities']!==f.activity)return false;
    if(f.objective!=='all'&&r['Objective']!==f.objective)return false;
    if(f.dateFrom&&r['Date']<f.dateFrom)return false;
    if(f.dateTo&&r['Date']>f.dateTo)return false;
    return true;
  });
}
function setSort(col){sortCol===col?sortDir*=-1:(sortCol=col,sortDir=-1);render()}
function setDDTab(panel,tab){ddTab[panel]=tab;render()}
function setTrendMetric(m){trendMetric=m;render()}
function clearDates(){['filter-date-from','filter-date-to'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=''});render()}
function refreshData(){const btn=document.getElementById('refresh-btn');if(btn)btn.classList.add('spinning');allData=[];document.getElementById('main-content').innerHTML=`<div class="loading-state"><div class="spinner"></div><span>Refreshing…</span></div>`;loadData().finally(()=>{const b=document.getElementById('refresh-btn');if(b)b.classList.remove('spinning')})}

