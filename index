    charts.act=new Chart(ctxA,{type:'bar',data:{labels:acts,datasets:[{data:acts.map(ac=>actSpend[ac]),backgroundColor:acts.map((_,i)=>pal[i%pal.length]+'cc'),borderColor:acts.map((_,i)=>pal[i%pal.length]),borderWidth:1,borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:tt(v=>fmtVND(Math.round(v)))},scales:{x:{grid:{color:'transparent'},ticks:{font:{size:10}}},y:{grid:{color:gc},ticks:{callback:v=>fmtVND(v)}}}}});
  }

  // IG visit trend
  const ctxIG=document.getElementById('chart-igvisit');
  if(ctxIG){
    charts.ig=new Chart(ctxIG,{type:'line',data:{labels:dateLabels,datasets:[{data:sortedDates.map(d=>byDate.igVisit[d]||0),borderColor:'#0d7a4e',backgroundColor:'#0d7a4e14',borderWidth:2,pointRadius:sortedDates.length>25?0:3,tension:.4,fill:true}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:tt(v=>fmt(Math.round(v)))},scales:{x:{grid:{color:gc},ticks:{maxRotation:0,maxTicksLimit:6}},y:{grid:{color:gc}}}}});
  }

  // Conv trend
  const ctxC=document.getElementById('chart-conv');
  if(ctxC){
    charts.conv=new Chart(ctxC,{type:'line',data:{labels:dateLabels,datasets:[{data:sortedDates.map(d=>byDate.convs[d]||0),borderColor:'#6b3fa0',backgroundColor:'#6b3fa014',borderWidth:2,pointRadius:sortedDates.length>25?0:3,tension:.4,fill:true}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:tt(v=>fmt(Math.round(v)))},scales:{x:{grid:{color:gc},ticks:{maxRotation:0,maxTicksLimit:6}},y:{grid:{color:gc}}}}});
  }
}

loadData();
</script>
