  const igVisit=rows.reduce((s,r)=>s+num(r,'Instagram profile visits'),0);
  const vid3s=rows.reduce((s,r)=>s+num(r,'3-second video plays'),0);
  return{
    imp,spend,clicks,results,convs,igVisit,vid3s,
    cpm:imp>0?spend/imp*1000:0,
    cpc:clicks>0?spend/clicks:0,
    cpr:results>0?spend/results:0,
    cpConv:convs>0?spend/convs:0,
    cpIG:igVisit>0?spend/igVisit:0,
    ctr:imp>0?clicks/imp*100:0,
    cvr:clicks>0?convs/clicks*100:0,
    hookRate:imp>0?vid3s/imp*100:0,
    cpa:results>0?spend/results:0,
  }
}

// ── Option A: Relative Score ──
// Each creative scored relative to the AVERAGE of the current filtered batch.
// Score 100 = best performer in this period. Benchmarks adjust automatically.
// Weights: CTR 35% (engagement signal), CPM 25% (delivery efficiency),
//          CPA 25% (result cost), CVR 15% (conversion quality)
function buildScoreCtx(crMap){
  const vals=Object.values(crMap).filter(d=>d.spend>0);
  const avg=arr=>arr.length?arr.reduce((a,b)=>a+b,0)/arr.length:0;
  return{
    avgCPM:avg(vals.filter(d=>d.imp>0).map(d=>d.spend/d.imp*1000)),
    avgCTR:avg(vals.filter(d=>d.imp>0).map(d=>d.clicks/d.imp)),
    avgCPA:avg(vals.filter(d=>d.results>0).map(d=>d.spend/d.results)),
    avgCVR:avg(vals.filter(d=>d.clicks>0).map(d=>d.convs/d.clicks)),
  }
}
function effScore(d,ctx){
  if(!d.spend||!ctx)return null;
  const cpm=d.imp>0?d.spend/d.imp*1000:null;
  const ctr=d.imp>0?d.clicks/d.imp:null;
  const cpa=d.results>0?d.spend/d.results:null;
  const cvr=d.clicks>0?d.convs/d.clicks:null;
  let total=0,weight=0;
  if(cpm&&ctx.avgCPM>0){total+=Math.min(2,ctx.avgCPM/cpm)*0.25;weight+=0.25}
  if(ctr&&ctx.avgCTR>0){total+=Math.min(2,ctr/ctx.avgCTR)*0.35;weight+=0.35}
  if(cpa&&ctx.avgCPA>0){total+=Math.min(2,ctx.avgCPA/cpa)*0.25;weight+=0.25}
  if(cvr&&ctx.avgCVR>0){total+=Math.min(2,cvr/ctx.avgCVR)*0.15;weight+=0.15}
  if(!weight)return null;
  // Normalise to 0-100
  const raw=(total/weight)*50; // weight-adj avg, max=100
  return Math.min(100,Math.round(raw));
}
function scorePill(s){
  if(s===null)return`<span class="muted">—</span>`;
  const cls=s>=70?'hi':s>=40?'mid':'lo';
  const icon=s>=70?'↑':s>=40?'→':'↓';
  return`<span class="score-pill ${cls}">${icon} ${s}</span>`;
}
